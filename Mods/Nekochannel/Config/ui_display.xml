			<display_entry name="dDuration" title_key="statDuration" display_type="Time"/>
		</item_display_info>
	
	</insertBefore>
	
	<insertBefore xpath="ui_display_info/item_display/item_display_info[@display_type='food']">
	
		<item_display_info display_type="foodYucca" display_group="groupConsumables">
