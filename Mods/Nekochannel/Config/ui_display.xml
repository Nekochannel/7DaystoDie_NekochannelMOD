<configs>
	<!-- -->
	<insertBefore xpath="ui_display_info/item_display/item_display_info[@display_type='medicalPainkillers']">
	
		<item_display_info display_type="medicalCaffeines" display_group="groupConsumables">
			<display_entry name="dInstantStamina" title_key="statShowInstantStamina"/>
			<display_entry name="dStaminaRegen" title_key="statStaminaRegen" display_type="Percent"/>
			<display_entry name="dInstantHealth" title_key="statHealthDmg"/>
