<configs>
	<!-- Enables the HP bar -->
	<set xpath="/windows/window[@name='windowTargetBar']/@visibility">always</set>
	
	<!-- general hp bar settings -->
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/@height">12</set>
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/@width">300</set>
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/@pos">-150,-100</set>
	
	<!-- Black bar in Background -->
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/sprite[@depth='1']/@width">300</set>
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/sprite[@depth='1']/@color">0,0,0,160</set>
	
	<!-- Red bar -->
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/filledsprite[@depth='2']/@width">300</set>
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/filledsprite[@depth='2']/@color">120,0,0,210</set>
	
	<!-- Lable -->
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/label[@depth='3']/@pos">150,-25</set>
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/label[@depth='3']/@font_size">22</set>
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/label[@depth='3']/@justify">center</set>
	<set xpath="/windows/window[@name='windowTargetBar']/rect[1]/label[@depth='3']/@pivot">center</set>
</configs>